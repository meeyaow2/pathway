# Pathway configuration. Copy to .env for local use (never commit .env).
# On Vercel, add these under Project → Settings → Environment Variables.
# Everything is OPTIONAL: with nothing set, Pathway uses free keyless providers
# (Photon search + Valhalla walking/wheelchair routing, both OpenStreetMap data).

# Optional OneMap (official Singapore addresses). Email + password lets the
# server renew the 3-day token automatically. Server-side only.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
# ONEMAP_TOKEN=            # alternative: a static token (expires after ~3 days)
# PATHWAY_ROUTER=onemap    # use OneMap for the standard walking route (step-free stays on Valhalla)

# Persistent barrier reports in the cloud (Vercel Marketplace → Upstash for Redis
# adds these automatically; KV_REST_API_URL / KV_REST_API_TOKEN also work).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Moderation: a long random string. Send as "Authorization: Bearer <token>".
PATHWAY_ADMIN_TOKEN=
# PATHWAY_REPORT_LIMIT=5   # reports per connection per 10 minutes

# Identify your deployment to the free OSM services (their usage policies ask for this),
# e.g. "Pathway/0.3 (contact: you@example.com)".
PATHWAY_USER_AGENT=

PORT=8765
HOST=127.0.0.1
